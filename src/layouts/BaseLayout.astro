---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title?: string; description?: string }
const { title = 'GIMNASIO CHANG taekwondo', description = 'blog del Gimnasio Chang, enseñando taekwondo en Valencia desde 1978' } = Astro.props;
---
<!doctype html>
<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><meta name="theme-color" content="#111111" /><link rel="icon" type="image/png" href="/favicon.png?v=3" sizes="64x64" /><link rel="icon" href="/favicon.ico" sizes="any" /><title>{title}</title></head>
<body><a class="skip-link" href="#content">Saltar al contenido</a><div class="site-frame"><SiteHeader /><main id="content"><slot /></main><SiteFooter /></div></body></html>
