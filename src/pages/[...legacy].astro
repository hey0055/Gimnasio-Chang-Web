---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/PageShell.astro';
import { legacyListings } from '../data/legacy-content';

export function getStaticPaths() {
  const paths = [...new Set([...legacyListings.home.matchAll(/href="\/(?!index\.php\/|assets\/)([^"#?]+)"/g)].map((match) => match[1].replace(/\/$/, '')))];
  return paths.map((legacy) => ({ params: { legacy } }));
}
---

