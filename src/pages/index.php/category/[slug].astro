---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LegacyContent from '../../../components/LegacyContent.astro';
import PageShell from '../../../components/PageShell.astro';
import { legacyListings } from '../../../data/legacy-content';
export function getStaticPaths() {
  const categories = [
    ['02 Corea', 'corea'], ['academia', 'academia'], ['alumnos', 'alumnos'], ['avisos', 'avisos'], ['campeonatos', 'campeonatos'], ['club', 'club'], ['combate', 'combate'], ['Coreano', 'coreano'], ['crónica', 'cronica'], ['Cultura', 'cultura'], ['curiosidades', 'curiosidades'], ['entrenamiento', 'entrenamiento'], ['exámenes', 'examenes'], ['festivos', 'festivos'], ['fotografías', 'fotografias'], ['fotos', 'fotos'], ['historia', 'historia'], ['información', 'informacion'], ['noticias', 'noticias'], ['opinión', 'opinion'], ['premios', 'premios'], ['salud', 'salud'], ['técnica', 'tecnica'], ['Uncategorized', 'uncategorized'], ['videos', 'videos'],
  ];
  return categories.map(([category, slug]) => ({ params: { slug }, props: { category, slug } }));
}
const { category } = Astro.props;
const { slug } = Astro.props;
---
<BaseLayout title={`${category} | GIMNASIO CHANG taekwondo`}><PageShell>{slug === 'academia' ? <LegacyContent content={legacyListings.academia} className="legacy-listing" /> : <section class="coming-soon"><h1>{category}</h1><p>Esta sección del archivo histórico se incorporará en la segunda fase del blog.</p><p><a href="/">Volver a la portada</a></p></section>}</PageShell></BaseLayout>
