---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageShell from '../../../components/PageShell.astro';
import BlogListing from '../../../components/BlogListing.astro';
import { allPosts, blogArchives } from '../../../lib/blog';
export async function getStaticPaths() {
  return [...blogArchives(await allPosts())].filter(([path]) => path.startsWith('/index.php/category/')).map(([path, archive]) => ({ params: { slug: path.split('/')[3] }, props: { ...archive, path } }));
}
const { posts, title, path } = Astro.props;
---
<BaseLayout title={`${title} | GIMNASIO CHANG taekwondo`}><PageShell><BlogListing posts={posts} title={title} basePath={path} /></PageShell></BaseLayout>
