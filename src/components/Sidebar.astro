---
import { getCollection } from 'astro:content';
import { archiveMonths, categories, clubLinks, taekwondoLinks } from '../data/site';
const posts = (await getCollection('posts')).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const placeholder = '/blog-en-preparacion/';
---
<aside class="sidebar" aria-label="Información complementaria"><section><h2>ENCUÉNTRANOS</h2><p><strong>Dirección:</strong><br />calle Matias Perelló 43<br />Valencia</p><p><strong>Contacto:</strong><br />telf. <a href="tel:+34616441356">616441356</a><br /><a href="mailto:gimnasiochang@gmail.com">gimnasiochang@gmail.com</a></p><img class="sidebar-budo" src="/assets/legacy/2008/11/images.jpg" alt="Portada de la revista Budo" loading="lazy" /></section><section><h2>POSTS RECIENTES</h2><ul>{posts.map((post) => <li><a href={post.data.legacyPath}>{post.data.title}</a></li>)}</ul></section><section><h2>NUBE</h2><p class="tag-cloud">{categories.map((category) => <a href={placeholder} title={`Archivo de ${category}`}>{category}</a>)}</p></section><section><h2>GIMNASIOS AMIGOS</h2><ul>{clubLinks.map(([name, href]) => <li><a href={href} target="_blank" rel="noreferrer">{name}</a></li>)}</ul></section><section><h2>WEBS DE TAEKWONDO</h2><ul>{taekwondoLinks.map(([name, href]) => <li><a href={href} target="_blank" rel="noreferrer">{name}</a></li>)}</ul></section><section><h2>ARCHIVES</h2><label class="sr-only" for="archive-select">Archivo histórico</label><select id="archive-select" onchange={`window.location.href='${placeholder}'`}><option>Seleccionar mes</option>{archiveMonths.map((month) => <option>{month}</option>)}</select></section></aside>
